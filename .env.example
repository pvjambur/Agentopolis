# ============================================
# AGENTOPOLIS — Environment Configuration
# ============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=               # Direct Postgres connection string for Alembic

# --- Vector Database (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=product-catalog
PINECONE_ENVIRONMENT=          # e.g., us-east-1

# --- Cache & Queue (Upstash Redis) ---
UPSTASH_REDIS_URL=             # Redis REST URL
UPSTASH_REDIS_TOKEN=           # Redis REST token
CELERY_BROKER_URL=             # redis://... URL for Celery
CELERY_RESULT_BACKEND=         # Same as CELERY_BROKER_URL

# --- LLM Providers ---
ANTHROPIC_API_KEY=             # Claude Sonnet for agent negotiation
GROQ_API_KEY=                  # Llama for shopping list parsing

# --- Payments (Razorpay TEST MODE) ---
RAZORPAY_KEY_ID=               # Test mode key_id from Razorpay Dashboard
RAZORPAY_KEY_SECRET=           # Test mode key_secret
RAZORPAY_WEBHOOK_SECRET=       # Webhook signature verification secret

# --- Monitoring ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=             # e.g., https://cloud.langfuse.com
SENTRY_DSN=

# --- App Config ---
APP_ENV=local                  # local | production
FRONTEND_URL=http://localhost:5173
